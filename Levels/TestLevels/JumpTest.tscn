[sub_resource type="GDScript" id="GDScript_jgiey"]
script/source = "extends Node3D

@onready var velocity_label: Label = $DebugPanel/VelocityLabel

func _ready() -> void:
	for skill in SkillManager.Skills:
		SkillManager.unlock_skill(SkillManager.Skills[skill])

func _process(_delta: float) -> void:
	velocity_label.text = str(Player.instance.player_ball.velocity.x)
"

